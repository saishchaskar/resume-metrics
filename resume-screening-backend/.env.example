# Flask/API configuration
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_PATH=./users.local.db
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google Cloud Storage. Create this bucket in GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BUCKET_NAME=resume-screening-resumes

# Durable 2-phase ZIP pipeline (production Cloud Run)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# CLOUD_TASKS_LOCATION=asia-south1
# CLOUD_TASKS_QUEUE=resumemetrics-batch-scoring
# CLOUD_TASKS_SERVICE_ACCOUNT=resumemetrics-task-invoker@your-gcp-project-id.iam.gserviceaccount.com
# BATCH_WORKER_URL=https://your-existing-flask-backend-app.run.app
# BATCH_PREPROCESS_JOB=resumemetrics-batch-preprocess
# CLOUD_RUN_JOB_REGION=asia-south1
# MAX_BATCH_ZIP_BYTES=1073741824
# MAX_BATCH_EXPANDED_BYTES=10737418240
# MAX_RESUME_BYTES=10485760

# Careers portal intake uses the same Cloud Tasks queue and worker identity.
# INTEGRATION_WORKER_URL=https://your-existing-flask-backend-app.run.app

# Optional if you use a service-account key file instead of ADC impersonation.
# Keep the JSON key outside this repository and uncomment/set the absolute path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
